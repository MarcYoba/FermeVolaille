{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    {# Affichage global des erreurs du formulaire s'il y en a #}
    {{ form_errors(form) }}

    <div class="row g-3">
        {# Boucle ou affichage personnalisé des champs avec les classes Bootstrap #}
        {% for field in form %}
            {% if field.vars.name != '_token' %}
                <div class="col-md-12">
                    <div class="form-group mb-3">
                        {{ form_label(field, null, {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                        {{ form_widget(field, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(field) }}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>

    <br>
    
    {# Bouton de soumission personnalisé aux couleurs du thème #}
    <div class="d-grid gap-2 pt-2">
        <button class="btn btn-lg text-white shadow-sm" type="submit" style="background-color: #1b4d3e; border-color: #1b4d3e; font-weight: 500;">
            <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}