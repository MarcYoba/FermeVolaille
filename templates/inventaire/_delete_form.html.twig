<form method="post" action="{{ path('app_inventaire_delete', {'id': inventaire.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet inventaire ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ inventaire.id) }}">
    <button class="btn btn-outline-danger shadow-sm px-4">
        <i class="fas fa-trash-alt me-1"></i> Supprimer
    </button>
</form>
