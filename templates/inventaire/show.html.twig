{% extends 'base.html.twig' %}

{% block title %}Détails de l'Inventaire{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}

<div class="min-vh-100 py-4" style="background-color: #1b4d3e;">
  <div class="container">
    <div class="row d-flex justify-content-center align-items-center">
      <div class="col-md-9 col-lg-8 col-xl-7">
        
        {# Carte principale #}
        <div class="card shadow-lg border-0" style="border-radius: 1rem; overflow: hidden;">
          <div class="p-4 p-md-5" style="background-color: #f4f8f6;">
            
            {# En-tête de la carte avec titre et bouton de retour #}
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h3 class="mb-0" style="color: #1b4d3e; font-weight: bold;">
                <i class="fas fa-info-circle me-2"></i>Détails de l'Inventaire
              </h3>
              <a href="{{ path('app_inventaire_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
              </a>
            </div>

            <hr class="mb-4" style="color: #1b4d3e; opacity: 0.2;">

            {# Tableau des détails #}
            <div class="table-responsive mb-4">
              <table class="table table-bordered align-middle bg-white rounded shadow-sm">
                <tbody>
                    <tr>
                        <th class="w-25" style="background-color: #e2f0ed; color: #1b4d3e;">Id</th>
                        <td class="fw-bold">#{{ inventaire.id }}</td>
                    </tr>
                    <tr>
                        <th style="background-color: #e2f0ed; color: #1b4d3e;">Quantité</th>
                        <td>{{ inventaire.quantite }}</td>
                    </tr>
                    <tr>
                        <th style="background-color: #e2f0ed; color: #1b4d3e;">Date de création</th>
                        <td>{{ inventaire.createtAt ? inventaire.createtAt|date('Y-m-d H:i') : '' }}</td>
                    </tr>
                </tbody>
              </table>
            </div>

            {# Boutons d'actions (Éditer & Supprimer) #}
            <div class="d-flex justify-content-between align-items-center pt-2">
              <a href="{{ path('app_inventaire_edit', {'id': inventaire.id}) }}" class="btn text-white shadow-sm px-4" style="background-color: #1b4d3e; border-color: #1b4d3e;">
                <i class="fas fa-edit me-1"></i> Modifier
              </a>

              <div>
                {{ include('inventaire/_delete_form.html.twig') }}
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</div>
{% endblock %}