{% extends 'base.html.twig' %}

{% block title %}Nouveau Inventaire{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}

<div class="min-vh-100 py-4" style="background-color: #1b4d3e;">
  <div class="container">
    <div class="row d-flex justify-content-center align-items-center">
      <div class="col-md-9 col-lg-8 col-xl-7">
        
        {# Carte principale #}
        <div class="card shadow-lg border-0" style="border-radius: 1rem; overflow: hidden;">
          <div class="p-4 p-md-5" style="background-color: #f4f8f6;">
            
            {# En-tête de la carte #}
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h3 class="mb-0" style="color: #1b4d3e; font-weight: bold;">
                <i class="fas fa-boxes me-2"></i>Nouveau Inventaire
              </h3>
              <a href="{{ path('app_inventaire_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
              </a>
            </div>

            {# 💡 MANUEL D'UTILISATION (Discret, informatif et fermable) #}
            <div class="alert alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background-color: #e2f0ed; color: #0d382b;">
              <div class="d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x me-3" style="color: #1b4d3e;"></i>
                <div>
                  <h6 class="alert-heading mb-1" style="font-weight: bold;">Manuel d'utilisation</h6>
                  <p class="mb-0" style="font-size: 0.85rem;">
                    Sélectionnez le produit concerné, renseignez la quantité exacte et validez l'enregistrement. Vous pouvez fermer ce message à tout moment en cliquant sur la croix.
                  </p>
                </div>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <hr class="mb-4" style="color: #1b4d3e; opacity: 0.2;">

            {# Inclusion du formulaire #}
            {{ include('inventaire/_form.html.twig') }}

          </div>
        </div>

      </div>
    </div>
  </div>
</div>
<script src="{{ asset('js/recherche/recherche.js')}}"></script>
{% endblock %}
