<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        
        {# 1. Meta Viewport mobile obligatoire pour un affichage parfait en WebView #}
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
        
        <title>{% block title %}App Suivi{% endblock %}</title>

        <link rel="icon" href="{{ asset('img/logo.jpg') }}">

        {# 2. CSS critique WebView (évite le flash blanc / FOUC et bloque les zooms/gestes parasites) #}
        <style>
            body {
                -webkit-touch-callout: none;
                -webkit-user-select: none;
                user-select: none;
                -webkit-tap-highlight-color: transparent;
                overscroll-behavior-y: none;
                background-color: #f8f9fa;
                margin: 0;
                padding: 12px;
            }

            /* Autorise la sélection de texte dans les formulaires et empêche le zoom iOS */
            input, textarea, select {
                -webkit-user-select: auto;
                user-select: auto;
                font-size: 16px !important;
            }

            /* Assure que le conteneur des graphiques (canvas) prend bien toute la largeur */
            .chart-container, canvas {
                max-width: 100% !important;
                height: auto !important;
            }
        </style>

        {% block stylesheets %}
        {% endblock %}

        {# 3. Chargement correct des assets via AssetMapper (Importmap) #}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# 4. Gestion du Hot Reload FrankenPHP #}
        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {# 5. Structure principale épurée (sans navbar/footer) #}
        <main class="webview-container">
            {# Messages Flash Symfony (Erreurs / Succès) #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} mb-3">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>