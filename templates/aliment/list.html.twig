{% extends 'base.html.twig' %}

{% block title %}Suivi{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}

<section class="min-vh-100 py-5" style="background-color: #eee;">
  <div class="container-fluid px-4">
    <div class="row d-flex justify-content-center align-items-center">
      <div class="col-12">
        <div class="card text-black shadow-lg" style="border-radius: 15px;">
          <div class="card-body p-4">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h3 class="fw-bold mb-0"> List des Alimentations </h3>
              <a href="{{ path('app_aliment') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouveau Alimentation
              </a>
            </div>

            {# Conteneur responsive pour éviter que le tableau ne dépasse #}
            <div class="table-responsive">
              <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Nom</th>
                    <th scope="col">Code </th>
                    <th scope="col">Unité de Mesure</th>
                    <th scope="col">Quantite Stock</th>
                    <th scope="col">stock Minimum</th>
                    <th scope="col">Prix Unitaire </th>
                    <th scope="col" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for aliment in aliments %}
                    <tr>
                      <th scope="row">{{ aliment.id }}</th>
                      {# Correction de la faute createtAt -> date #}
                      <td>{{ aliment.nom }}</td>
                      <td>
                        {% if aliment.code %}
                          <span class="badge bg-info text-dark">{{ aliment.code }}</span>
                        {% else %}
                          <span class="text-muted">-</span>
                        {% endif %}
                      </td>
                      <td>{{ aliment.uniteMesure }} </td>
                      <td>{{ aliment.quantiteStock }}</td>
                      <td>{{ aliment.stockMinimum }}</td>
                      <td>
                        {% if aliment.prixUnitaire  %}
                          <span class="badge bg-info text-dark">{{ aliment.prixUnitaire }}</span>
                        {% else %}
                          <span class="text-muted">-</span>
                        {% endif %}
                      </td>

                      <td class="text-center">
                        <div class="btn-group" role="group">
                          {# Redirection corrigée vers la route suivi #}
                          <a href="{{ path('app_aliment_edit', {'id': aliment.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            Modifier
                          </a>
                          
                          {# Formulaire de suppression sécurisé CSRF #}
                          <form method="post" action="{{ path('app_aliment_delete', {'id': aliment.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce mouvement ?');" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ aliment.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                              Supprimer
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="14" class="text-center py-4 text-muted">
                        Aucun enregistrement de suivi trouvé.
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}