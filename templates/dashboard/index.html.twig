{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - Pharmacie{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}
<div class="container my-5">
    {# En-tête #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-primary mb-1">
                <i class="bi bi-speedometer2 me-2"></i>Tableau de Bord
            </h1>
            <p class="text-muted mb-0">Vue synthétique de l'activité, des stocks et des alertes sanitaires.</p>
        </div>
        <div>
            <a href="{{ path('app_approvisionnement_nouveau') }}" class="btn btn-primary me-2">
                <i class="bi bi-box-arrow-in-down me-1"></i> Réception Stock
            </a>
            <a href="{{ path('app_delivrance_nouvelle') }}" class="btn btn-success">
                <i class="bi bi-cart-plus me-1"></i> Nouvelle Sortie
            </a>
        </div>
    </div>

    {# 1. CARTE DES INDICATEURS CLÉS (KPIs) #}
    <div class="row g-3 mb-4">
        {# Chiffre d'affaires #}
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-cash-stack fs-2"></i>
                    </div>
                    <div>
                        <h6 class="card-subtitle text-white-50 mb-1">Chiffre d'Affaires</h6>
                        <h3 class="card-title mb-0 fw-bold">{{ chiffreAffaires|number_format(2, ',', ' ') }} €</h3>
                    </div>
                </div>
            </div>
        </div>

        {# Total Délivrances #}
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-receipt fs-2"></i>
                    </div>
                    <div>
                        <h6 class="card-subtitle text-white-50 mb-1">Sortie produit</h6>
                        <h3 class="card-title mb-0 fw-bold">{{ totalDelivrances }}</h3>
                    </div>
                </div>
            </div>
        </div>

        {# Stock en Alerte #}
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-dark bg-opacity-10 p-3 me-3">
                        <i class="bi bi-exclamation-triangle fs-2"></i>
                    </div>
                    <div>
                        <h6 class="card-subtitle text-dark-50 mb-1">Alertes Stock</h6>
                        <h3 class="card-title mb-0 fw-bold">{{ medicamentsAlerteStock|length }} produit(s)</h3>
                    </div>
                </div>
            </div>
        </div>

        {# Péremptions Proches / Dépassées #}
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-calendar-x fs-2"></i>
                    </div>
                    <div>
                        <h6 class="card-subtitle text-white-50 mb-1">Péremptions < 30j</h6>
                        <h3 class="card-title mb-0 fw-bold">{{ lotsBientotPerimes|length }} lot(s)</h3>
                        {% if countLotsPerimes > 0 %}
                            <small class="badge bg-white text-danger mt-1">{{ countLotsPerimes }} périmé(s) !</small>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 2. SECTION DÉTAILLÉE DES ALERTES #}
    <div class="row g-4 mb-4">
        {# Alertes Stock Faible #}
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold text-warning border-0 pt-3">
                    <i class="bi bi-box-seam me-2"></i>Produits sous le Seuil de Stock Minimal
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produit</th>
                                <th>Seuil Min.</th>
                                <th>Stock Actuel</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for med in medicamentsAlerteStock %}
                            {% set totalStock = 0 %}
                            {% for lot in med.lots %}
                                {% set totalStock = totalStock + lot.quantiteEnStock %}
                            {% endfor %}
                            <tr>
                                <td class="fw-bold">{{ med.nomCommercial }}</td>
                                <td>{{ med.seuilAlerte }}</td>
                                <td>
                                    <span class="badge bg-danger">{{ totalStock }}</span>
                                </td>
                                <td>
                                    <a href="{{ path('app_approvisionnement_nouveau') }}" class="btn btn-sm btn-outline-primary">Recommander</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Aucune alerte de stock.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Alertes Péremptions Imminentes #}
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold text-danger border-0 pt-3">
                    <i class="bi bi-clock-history me-2"></i>Lots Proches de la Péremption
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produit / N° Lot</th>
                                <th>Expiration</th>
                                <th>Reste en stock</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for lot in lotsBientotPerimes %}
                            <tr>
                                <td>
                                    <span class="fw-bold d-block">{{ lot.medicament ? lot.medicament.nomCommercial : 'Inconnu' }}</span>
                                    <small class="text-muted">Lot: {{ lot.numeroLot }}</small>
                                </td>
                                <td>
                                    <span class="badge bg-danger">
                                        {{ lot.dateExpiration|date('d/m/Y') }}
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">{{ lot.quantiteEnStock }} pce(s)</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">Aucun lot en péremption imminente.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# 3. HISTORIQUE DES DERNIÈRES VENTES #}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold text-primary border-0 pt-3 d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clock-history me-2"></i>Dernières Délivrances Enregistrées</span>
            <a href="{{ path('app_delivrance_list') }}" class="btn btn-sm btn-link">Voir tout l'historique</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Produit</th>
                            <th>Qté</th>
                            <th>Motif</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for sortie in dernieresSorties %}
                        {% set lot = sortie.lot %}
                        {% set med = lot ? lot.medicament : null %}
                        {% set cout = sortie.coutSanitaire ?? null %}
                        <tr>
                            <td>{{ sortie.dateSortie|date('d/m/Y H:i') }}</td>
                            <td class="fw-bold">{{ med ? med.nomCommercial : '-' }}</td>
                            <td><span class="badge bg-warning text-dark">-{{ sortie.quantiteSortie }}</span></td>
                            <td>{{ sortie.traitement ? sortie.traitement.nomTraitement : sortie.motifSortie }}</td>
                            <td class="text-end fw-bold">{{ cout ? cout.montantBrut|number_format(2, ',', ' ') ~ ' €' : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Aucune transaction récente.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
