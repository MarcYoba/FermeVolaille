{% extends 'base.html.twig' %}

{% block title %}Suivi{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}

<section class="min-vh-100 py-5" style="background-color: #eee;">
  <div class="container-fluid px-4">
    <div class="row d-flex justify-content-center align-items-center">
      <div class="col-12">
        <div class="card text-black shadow-lg" style="border-radius: 15px;">
          <div class="card-body p-4">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h3 class="fw-bold mb-0">Historique des Suivis Quotidiens</h3>
              <a href="{{ path('app_suivi') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouveau Suivi
              </a>
            </div>

            {# Conteneur responsive pour éviter que le tableau ne dépasse #}
            <div class="table-responsive">
              <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Date</th>
                    <th scope="col">Bande</th>
                    <th scope="col">Âge</th>
                    <th scope="col">Temp (°C)</th>
                    <th scope="col">Humidité (%)</th>
                    <th scope="col">Aliment (kg)</th>
                    <th scope="col">Eau (L)</th>
                    <th scope="col">Morts</th>
                    <th scope="col">Réformes</th>
                    <th scope="col">Eff. Initial</th>
                    <th scope="col">Eff. Restant</th>
                    <th scope="col">Observations</th>
                    <th scope="col" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for suivi in suivis %}
                    <tr>
                      <th scope="row">{{ suivi.id }}</th>
                      {# Correction de la faute createtAt -> date #}
                      <td>{{ suivi.createtAt ? suivi.createtAt|date('d/m/Y') : '' }}</td>
                      <td>
                        {% if suivi.bande is defined and suivi.bande %}
                          <span class="badge bg-info text-dark">{{ suivi.bande.matricule }}</span>
                        {% else %}
                          <span class="text-muted">-</span>
                        {% endif %}
                      </td>
                      <td>{{ suivi.age }} j</td>
                      <td>{{ suivi.temperature ? suivi.temperature ~ '°C' : '-' }}</td>
                      <td>{{ suivi.humidite ? suivi.humidite ~ '%' : '-' }}</td>
                      <td>{{ suivi.consommationAliment }}</td>
                      <td>{{ suivi.consommationEau }}</td>
                      <td><span class="badge bg-danger">{{ suivi.nombreMorts }}</span></td>
                      <td><span class="badge bg-warning text-dark">{{ suivi.reformes }}</span></td>
                      <td>{{ suivi.effectifInitial }}</td>
                      
                      {# Utilisation du getter calculé de l'entité #}
                      <td class="fw-bold text-success">{{ suivi.effectifRestant }}</td>
                      
                      <td>
                        <small class="text-muted">{{ suivi.observations|default('Aucune')|u.truncate(20, '...') }}</small>
                      </td>
                      
                      <td class="text-center">
                        <div class="btn-group" role="group">
                          {# Redirection corrigée vers la route suivi #}
                          <a href="{{ path('app_suivi_edit', {'id': suivi.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            Modifier
                          </a>
                          
                          {# Formulaire de suppression sécurisé CSRF #}
                          <form method="post" action="{{ path('app_suivi_delete', {'id': suivi.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce suivi ?');" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suivi.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                              Supprimer
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="14" class="text-center py-4 text-muted">
                        Aucun enregistrement de suivi trouvé.
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}