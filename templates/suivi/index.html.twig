{% extends is_webview ? 'base_webview.html.twig' : 'base.html.twig' %}

{% block title %}Suivi Quotidien de la Bande{% endblock %}

{% block body %}
{# Navbar Web classique (masquée dans la WebView) #}
{% if not is_webview %}
    {% include "navbar.html.twig" %}
{% endif %}

<div class="container-fluid min-vh-100 {{ is_webview ? 'p-2 pb-5 mb-4' : 'py-4 bg-secondary' }}">
  <div class="row justify-content-center align-items-center">
    <div class="col-12 col-md-8 col-lg-6">
        
        <div class="card {{ is_webview ? 'border-0 bg-transparent' : 'shadow' }}">
          <div class="card-body {{ is_webview ? 'p-1' : 'p-4' }}">
            
            <h3 class="text-center mb-4 fw-bold h4">Suivi Quotidien de la Bande</h3>

            {# Affichage des erreurs globales du formulaire #}
            {{ form_errors(form) }}

            {{ form_start(form) }}
              
              <div class="row g-2">
                {# Date et Âge #}
                <div class="col-6">
                  {{ form_row(form.createtAt) }}
                </div>
                <div class="col-6">
                  {{ form_row(form.age) }}
                </div>

                {# Température et Humidité #}
                <div class="col-6">
                  {{ form_row(form.temperature) }}
                </div>
                <div class="col-6">
                  {{ form_row(form.humidite) }}
                </div>

                {# Consommations #}
                <div class="col-6">
                  {{ form_row(form.consommationAliment) }}
                </div>
                <div class="col-6">
                  {{ form_row(form.consommationEau) }}
                </div>

                {# Perte & Écarts #}
                <div class="col-6">
                  {{ form_row(form.nombreMorts) }}
                </div>
                <div class="col-6">
                  {{ form_row(form.reformes) }}
                </div>

                {# Effectif initial du jour & Bande #}
                <div class="col-6">
                  {{ form_row(form.effectifInitial) }}
                </div>
                <div class="col-6">
                  {{ form_row(form.bande) }}
                </div>

                {# Observations en pleine largeur #}
                <div class="col-12">
                  {{ form_row(form.observations) }}
                </div>
              </div>

              {# Bouton de validation #}
              <div class="text-center mt-4">
                <button class="btn btn-primary btn-lg w-100 shadow-sm" type="submit">
                  Enregistrer le suivi
                </button>
              </div>

            {{ form_end(form) }}

          </div>
        </div>

    </div>
  </div>
</div>

{# Navigation du bas : 100% Bootstrap 5 pur #}
{% if is_webview %}
<nav class="navbar fixed-bottom navbar-light bg-white border-top p-0 shadow-sm">
    <div class="container-fluid p-0">
        <div class="row g-0 w-100 text-center">
            
            <div class="col-3">
                <a href="{{ path('app_home') }}" class="nav-link text-secondary py-2">
                    <div class="fs-5 lh-1">⌂</div>
                    <small class="d-block" style="font-size: 10px;">Home</small>
                </a>
            </div>

            <div class="col-3">
                <a href="{{ path('app_bandes_liste') }}" class="nav-link text-secondary py-2">
                    <div class="fs-5 lh-1">☰</div>
                    <small class="d-block" style="font-size: 10px;">Bandes</small>
                </a>
            </div>

            <div class="col-3">
                <a href="{{ path('app_delivrance_list') }}" class="nav-link text-secondary py-2">
                    <div class="fs-5 lh-1">💊</div>
                    <small class="d-block" style="font-size: 10px;">Médicaments</small>
                </a>
            </div>

            <div class="col-3">
                <a href="{{ path('app_dashboard') }}" class="nav-link text-secondary py-2">
                    <div class="fs-5 lh-1">📊</div>
                    <small class="d-block" style="font-size: 10px;">Graphes</small>
                </a>
            </div>

        </div>
    </div>
</nav>
{% endif %}

{% endblock %}