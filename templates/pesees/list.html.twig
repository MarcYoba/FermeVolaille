{% extends 'base.html.twig' %}

{% block title %}Suivi{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}

<section class="min-vh-100 py-5" style="background-color: #eee;">
  <div class="container-fluid px-4">
    <div class="row d-flex justify-content-center align-items-center">
      <div class="col-12">
        <div class="card text-black shadow-lg" style="border-radius: 15px;">
          <div class="card-body p-4">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h3 class="fw-bold mb-0">Historique des Suivis Quotidiens</h3>
              <a href="{{ path('app_suivi') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouveau Suivi
              </a>
            </div>

            {# Conteneur responsive pour éviter que le tableau ne dépasse #}
            <div class="table-responsive">
              <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Date</th>
                    <th scope="col">Bandes </th>
                    <th scope="col">Nombre Sujets Pesés</th>
                    <th scope="col">Poids Total Echantillon</th>
                    <th scope="col">poids Moyen</th>
                    <th scope="col">Gain moyen quotidien </th>
                    
                    <th scope="col" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for pesee in pesees %}
                    <tr>
                      <th scope="row">{{ pesee.id }}</th>
                      {# Correction de la faute createtAt -> date #}
                      <td>{{ pesee.createtAt ? pesee.createtAt|date('d/m/Y') : '' }}</td>
                      <td>
                        {% if pesee.bande is defined and pesee.bande %}
                          <span class="badge bg-info text-dark">{{ pesee.bande.matricule }}</span>
                        {% else %}
                          <span class="text-muted">-</span>
                        {% endif %}
                      </td>
                      <td>{{ pesee.nombreSujetsPeses }} </td>
                      <td>{{ pesee.poidsTotalEchantillon ? pesee.poidsTotalEchantillon ~ ' g' : '-' }}</td>
                      <td>{{ pesee.poidsMoyen ? pesee.poidsMoyen ~ ' g' : '-' }}</td>
                      <td>{{ pesee.gmq ? pesee.gmq ~ ' g/jour' : '-' }}</td>
                      
                      <td class="text-center">
                        <div class="btn-group" role="group">
                          {# Redirection corrigée vers la route suivi #}
                          <a href="{{ path('app_pesees_edit', {'id': pesee.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            Modifier
                          </a>
                          
                          {# Formulaire de suppression sécurisé CSRF #}
                          <form method="post" action="{{ path('app_pesees_delete', {'id': pesee.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce pesee ?');" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pesee.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                              Supprimer
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="14" class="text-center py-4 text-muted">
                        Aucun enregistrement de suivi trouvé.
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}