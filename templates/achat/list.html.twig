{% extends (is_webview is defined and is_webview) ? 'base_webview.html.twig' : 'base.html.twig' %}

{% block title %}Gestion du Magasin - Achats{% endblock %}

{% block body %}
{# Style personnalisé pour le dégradé forêt et la table #}
<style>
    .bg-forest-gradient {
        background: linear-gradient(135deg, #0d3b2e 0%, #114b5f 50%, #1a5e63 100%);
    }
    .table-responsive {
        border-radius: 12px;
        overflow: hidden;
    }
</style>

{% if is_webview is not defined or not is_webview %}
    {% include "navbar.html.twig" %}
{% endif %}

<div class="container-fluid min-vh-100 d-flex flex-column {{ (is_webview is defined and is_webview) ? 'p-2' : 'py-4 bg-forest-gradient' }}">
    <div class="row justify-content-center align-items-center w-100 m-0 my-auto">
        <div class="col-12 col-xl-11">
            <div class="card {{ (is_webview is defined and is_webview) ? 'border-0 bg-transparent' : 'shadow-lg border-0 rounded-4' }}">
                <div class="card-body {{ (is_webview is defined and is_webview) ? 'p-1' : 'p-4 p-md-5 bg-white rounded-4' }}">
                    
                    {# En-tête avec titre et bouton d'action #}
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
                        <h2 class="fw-bold m-0 h3 text-dark">
                            <i class="fas fa-store me-2 text-success"></i>Gestion du Magasin - Achats
                        </h2>
                        <a href="{{ path('app_achat') }}" class="btn btn-success shadow-sm">
                            <i class="fas fa-plus-circle me-1"></i> Nouvel Achat
                        </a>
                    </div>

                    {# Table des achats #}
                    <div class="table-responsive shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark bg-success text-white">
                                <tr>
                                    <th scope="col" class="text-center">#</th>
                                    <th scope="col"><i class="fas fa-box me-1"></i>Produit</th>
                                    <th scope="col" class="text-center"><i class="fas fa-sort-numeric-up me-1"></i>Qté</th>
                                    <th scope="col" class="text-end"><i class="fas fa-tag me-1"></i>Prix Unit.</th>
                                    <th scope="col" class="text-end"><i class="fas fa-calculator me-1"></i>Montant Total</th>
                                    <th scope="col" class="text-center"><i class="fas fa-calendar-alt me-1"></i>Date</th>
                                    <th scope="col" class="text-center"><i class="fas fa-cogs me-1"></i>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for achat in achats %}
                                    <tr>
                                        <th scope="row" class="text-center text-muted">{{ achat.id }}</th>
                                        <td class="fw-semibold text-dark">
                                            {{ achat.produit.nom | default('Produit inconnu') }}
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border fw-normal px-2 py-1">
                                                {{ achat.quantite }}
                                            </span>
                                        </td>
                                        <td class="text-end">{{ achat.prix | number_format(0, ',', ' ') }} FCFA</td>
                                        <td class="text-end fw-bold text-success">
                                            {{ achat.montant | number_format(0, ',', ' ') }} FCFA
                                        </td>
                                        <td class="text-center small text-muted">
                                            {{ achat.createtAt ? achat.createtAt|date('d/m/Y') : 'N/A' }}
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="{{ path('app_achat_edit', {'id': achat.id}) }}" class="btn btn-outline-primary" title="Modifier">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="{{ path('app_achat_delete', {'id': achat.id}) }}" class="btn btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet achat ?');" title="Supprimer">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="fas fa-info-circle me-1"></i> Aucun achat enregistré pour le moment.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

{# Footer classique : Masqué sur WebView #}
{% if is_webview is not defined or not is_webview %}
    <footer class="bg-white border-top text-center py-3 mt-auto">
        <small class="text-muted">Copyright © {{ "now"|date("Y") }} - Tous droits réservés.</small>
    </footer>
{% endif %}
{% endblock %}