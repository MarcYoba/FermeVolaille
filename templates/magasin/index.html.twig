{% extends 'base.html.twig' %}

{% block title %}Magasin{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}
<section class="min-vh-100 bg-success bg-gradient py-5">
  <div class="container h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col col-xl-10">
        <div class="card shadow-lg border-0 rounded-4">

          {# 💡 MANUEL D'UTILISATION (Discret, informatif et fermable) #}
            <div class="alert alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background-color: #e2f0ed; color: #0d382b;">
              <div class="d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x me-3" style="color: #1b4d3e;"></i>
                <div>
                  <h6 class="alert-heading mb-1" style="font-weight: bold;">Manuel d'utilisation</h6>
                  <p class="mb-0" style="font-size: 0.85rem;">
                    <strong>Gestion du stock :</strong> Pour ajouter ou réduire le stock, écrivez un signe <strong>+</strong> (ex: +10) ou <strong>-</strong> (ex: -5) devant la quantité avant d'enregistrer. Sélectionnez ensuite le produit concerné et validez.
                  </p>
                </div>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          
          {# Section Formulaire #}
          <div class="card-body p-4 p-md-5 bg-light rounded-4">
            <h3 class="text-center text-success mb-4fw-bold">Information du Magasin</h3>
            
            {{ form_errors(form) }}

            {{ form_start(form) }}
              <div class="row g-3">
                <div class="col-md-6">
                  {{ form_label(form.produit, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                  <input type="text" id="recherche" onkeyup="magasin()" class="form-control form-control-lg mb-2" placeholder="Rechercher un Produit...">
                  {{ form_widget(form.produit, {
                    'attr': {
                      'class': 'form-select',
                      'size': 4
                    }
                  }) }}
                </div>
                
                <div class="col-md-6">
                  {{ form_label(form.quantite, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                  {{ form_widget(form.quantite, {'attr': {'class': 'form-control form-control-lg'}}) }}
                </div>

                <div class="col-md-6">
                  {{ form_widget(form.createtAt, {'attr': {'class': 'form-control'}}) }}
                </div>
              </div>
              
              <div class="text-center pt-4 mt-3">
                <button class="btn btn-success btn-lg w-100 fw-bold shadow-sm" type="submit">
                  Enregistrement
                </button>
              </div>

            {{ form_end(form) }}

          </div>

        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}