{% extends 'base.html.twig' %}

{% block title %}Magasin{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}
<section class="min-vh-100 py-5" style="background-color: #1e4d2b;">
  <div class="container h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-lg-12 col-xl-11">
        
        {# Carte principale #}
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
          
          {# En-tête de carte #}
          <div class="card-header p-4 text-white d-flex justify-content-between align-items-center" style="background-color: #143d21;">
            <h3 class="m-0 fw-bold">
              <i class="bi bi-box-seam me-2"></i>Gestion du Magasin
            </h3>
            <a href="{{ path('app_magasin') }}" class="btn btn-light text-success fw-bold shadow-sm">
              <i class="bi bi-plus-lg me-1"></i> Nouveau Produit
            </a>
          </div>

          {# Corps de carte avec tableau #}
          <div class="card-body p-4 bg-white">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="text-white" style="background-color: #1e4d2b;">
                  <tr>
                    <th scope="col" class="py-3 px-3"># ID</th>
                    <th scope="col" class="py-3">Produit</th>
                    <th scope="col" class="py-3 text-center">Quantité</th>
                    <th scope="col" class="py-3 text-center">Date d'ajout</th>
                    <th scope="col" class="py-3 text-end px-4">Actions</th>
                  </tr>
                </thead>
                <tbody class="border-top-0">
                  {% for magasin in magasins %}
                    <tr class="align-middle">
                      <th scope="row" class="px-3 fw-bold text-muted">{{ magasin.id }}</th>
                      <td class="fw-semibold text-dark">{{ magasin.produit.nom }}</td>
                      <td class="text-center">
                        <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-3 py-2 fs-6">
                          {{ magasin.quantite }}
                        </span>
                      </td>
                      <td class="text-center text-muted">
                        {{ magasin.createtAt | date('d/m/Y') }}
                      </td>
                      <td class="text-end px-4">
                        <div class="btn-group" role="group">
                          <a href="{{ path('app_magasin_edit', {'id': magasin.id}) }}" class="btn btn-outline-success btn-sm px-3 fw-semibold">
                            Éditer
                          </a>
                          <a href="{{ path('app_magasin_delete', {'id': magasin.id}) }}" class="btn btn-outline-danger btn-sm px-3 fw-semibold" onclick="return confirm('Confirmer la suppression ?');">
                            Supprimer
                          </a>
                        </div>
                      </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="5" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        Aucun enregistrement trouvé dans le magasin.
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
{% endblock %}