{% extends 'base.html.twig' %}

{% block title %}magasin{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}
<section class="vh-100" style="background-color: #eee;">
  <div class="container h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-lg-12 col-xl-11">
        <div class="card text-black" style="border-radius: 25px;">
          <div class="card-body p-md-5">
            <div class="row justify-content-center">

                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Produit</th>
                            <th scope="col">Quantite</th>
                            <th scope="col">Date</th>
                            <th scope="col">Operation</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for magasin in magasins %}
                            <tr>
                                <th scope="row">{{ magasin.id }}</th>
                                <td>{{ magasin.produit.nom }}</td>
                                <td>{{ magasin.quantite }}</td>
                                <td>{{ magasin.createtAt | date('Y-m-d') }}</td>
                                <td>
                                    <a href="{{ path('app_magasin_edit', {'id': magasin.id}) }}" class="btn btn-primary">Edit</a>
                                    <a href="{{ path('app_magasin_delete', {'id': magasin.id}) }}" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}