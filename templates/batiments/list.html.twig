{% extends 'base.html.twig' %}

{% block title %}Bloc{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}
<section class="vh-100" style="background-color: #eee;">
  <div class="container h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-lg-12 col-xl-11">
        <div class="card text-black" style="border-radius: 25px;">
          <div class="card-body p-md-5">
            <div class="row justify-content-center">

                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Nom</th>
                            <th scope="col">Surface</th>
                            <th scope="col">Capacite</th>
                            <th scope="col">Type</th>
                            <th scope="col">Etat</th>
                            <th scope="col">Date Contruction</th>
                            <th scope="col">Operation</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for batiment in batiments %}
                            <tr>
                                <th scope="row">{{ batiment.id }}</th>
                                <td>{{ batiment.nom }}</td>
                                <td>{{ batiment.surface }}</td>
                                <td>{{ batiment.capacite }}</td>
                                <td>{{ batiment.type }}</td>
                                <td>{{ batiment.etat }}</td>
                                <td>{{ batiment.createtAt | date('Y-m-d') }}</td>
                                <td>
                                    <a href="{{ path('app_batiments_edit', {'id': batiment.id}) }}" class="btn btn-primary">Edit</a>
                                    <a href="{{ path('app_batiments_delete', {'id': batiment.id}) }}" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}