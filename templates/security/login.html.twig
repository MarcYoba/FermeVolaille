{% extends (is_webview is defined and is_webview) ? 'base_webview.html.twig' : 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex flex-column justify-content-center {{ (is_webview is defined and is_webview) ? 'p-2' : 'py-4 bg-light' }}">
    <div class="row justify-content-center align-items-center w-100 m-0">
        
        {# Image illustrative : Masquée dans la WebView Android pour économiser l'espace d'écran #}
        {% if is_webview is not defined or not is_webview %}
            <div class="col-md-6 col-lg-5 text-center mb-4 mb-md-0 d-none d-md-block">
                <img src="{{ asset('img/logo.jpg') }}" class="img-fluid rounded shadow-sm" alt="Logo" style="max-height: 300px;">
            </div>
        {% endif %}

        {# Formulaire de connexion #}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card {{ (is_webview is defined and is_webview) ? 'border-0 bg-transparent' : 'shadow-sm border-0' }}">
                <div class="card-body {{ (is_webview is defined and is_webview) ? 'p-1' : 'p-4 bg-white rounded' }}">
                    
                    <h2 class="text-center fw-bold mb-4 h3">Connexion</h2>

                    {# Affichage des erreurs d'authentification #}
                    {% if error %}
                        <div class="alert alert-danger mb-3 p-2 small">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {# Message si déjà connecté #}
                    {% if app.user %}
                        <div class="alert alert-info mb-3 p-2 small text-center">
                            Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.<br>
                            <a href="{{ path('app_logout') }}" class="alert-link">Se déconnecter</a>
                        </div>
                    {% endif %}

                    <form method="post">
                        {# Champ Adresse Email (Floating Label Bootstrap 5) #}
                        <div class="form-floating mb-3">
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="nom@exemple.com" required autofocus>
                            <label for="username">Adresse email</label>
                        </div>

                        {# Champ Mot de passe (Floating Label Bootstrap 5) #}
                        <div class="form-floating mb-3">
                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="Mot de passe" required>
                            <label for="password">Mot de passe</label>
                        </div>

                        {# Jeton de sécurité CSRF #}
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {# Bouton de connexion #}
                        <button class="btn btn-primary btn-lg w-100 shadow-sm mt-2" type="submit">
                            Se connecter
                        </button>

                        {# Lien vers la création de compte #}
                        <div class="text-center mt-3">
                            <small class="text-muted">Vous n'avez pas de compte ? 
                                <a href="{{ path('app_register') }}" class="text-decoration-none fw-bold">S'inscrire</a>
                            </small>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

{# Footer Web classique : Masqué sur la WebView #}
{% if is_webview is not defined or not is_webview %}
    <footer class="bg-white border-top text-center py-3 mt-auto">
        <small class="text-muted">Copyright © {{ "now"|date("Y") }} - Tous droits réservés.</small>
    </footer>
{% endif %}
{% endblock %}